---
import Base from '../../layouts/Base.astro';
import MoveArt from '../../components/MoveArt.astro';
import { moves } from '../../data/moves';
import { path } from '../../lib/paths';
export function getStaticPaths() {
  return moves.map((move, index) => ({
    params: { slug: move.slug },
    props: { move, next: moves[(index + 1) % moves.length] },
  }));
}
const { move, next } = Astro.props;
---

<Base title={move.name} description={move.intro}>
  <header class="wrap page-heading">
    <a class="breadcrumb" href={path('moves/')}>
      ← All movement guides
    </a>
    <p class="eyebrow">
      {move.category} / {move.time} to explore
    </p>
    <h1>{move.name}</h1>
    <p>{move.intro}</p>
  </header>
  <div class="wrap exercise-layout">
    <aside class="exercise-visual">
      <div class={`card-${move.color}`}>
        <MoveArt type={move.type} />
        <p class="eyebrow">A cue to keep in your pocket</p>
        <blockquote>“{move.cue}”</blockquote>
      </div>
      <p class="illustration-note">
        Simplified illustration. Follow the instructions and your own comfort.
      </p>
      <div class="callout">
        <p>
          <strong>A starting point, not a prescription.</strong> Use less if needed. Stop for sharp
          or worsening pain, tingling, numbness, or dizziness.{' '}
          <a href={path('learn/#get-help')}>When to get support →</a>
        </p>
      </div>
    </aside>
    <div class="prose exercise-copy">
      <div class="exercise-stats">
        <span>{move.equipment}</span>
        <span>{move.dose}</span>
      </div>
      <button class="button button-outline print-button" type="button" id="print-guide">
        Print this guide ↗
      </button>
      <p class="print-only">
        deadbutt.fyi · General movement education, not individual medical advice.
      </p>
      <h2>Give it a try.</h2>
      <ol class="steps">
        {move.steps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
      <h3>What you might feel</h3>
      <p>{move.feel}</p>
      <h3>Make it easier</h3>
      <p>{move.easier}</p>
      <h3>When you’re ready for more</h3>
      <p>{move.progress}</p>
      <h3>Keep an eye on</h3>
      <p>{move.watch}</p>
      <p class="citation">
        These are editorial exercise examples, not a validated “dead butt” protocol.{' '}
        <a href={path('sources/')}>Read the evidence and approach →</a>
      </p>
      <div class="next-move">
        <a class="text-link" href={path('moves/')}>
          ← All moves
        </a>
        <a class="text-link" href={path(`moves/${next.slug}/`)}>
          Next: {next.name} →
        </a>
      </div>
    </div>
  </div>
</Base>
<script>
  document.querySelector('#print-guide')?.addEventListener('click', () => window.print());
</script>
